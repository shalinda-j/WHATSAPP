{
  "name": "whatsapp-web-bot",
  "main": "src/index.ts",
  "description": "WhatsApp Bot",
  "version": "0.8.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-bot",
    "whatsapp-api",
    "whatsapp-multi-session",
    "whatsapp-multi-device",
    "api",
    "bot",
    "client",
    "node",
    "nodejs",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/caioagiani/whatsapp-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caioagiani"
  },
  "author": {
    "name": "Work 360",
    "email": "support@work360.com",
    "url": "https://work360.com"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "dev": "tsnd --respawn --transpile-only --ignore-watch node_modules -r dotenv/config src/index.ts",
    "client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "build:client": "cd client && npm install && npm run build",
    "build": "npm run build:client && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -b client",
    "test": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --passWithNoTests --runInBand",
    "test:file": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --passWithNoTests --runInBand",
    "verify": "npm run typecheck && npm run test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "googleapis": "^176.0.0",
    "ics": "^3.12.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "nanoid": "^6.0.1",
    "openai": "^7.5.0",
    "p-queue": "^9.3.3",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "werift": "^0.24.4"
  },
  "overrides": {
    "axios": "^1.19.0",
    "minimatch": "^9.0.7",
    "multer": "^2.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@tootallnate/once": "^3.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "concurrently": "^10.0.5",
    "dotenv": "17.4.2",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "2.0.0",
    "typescript": "^5.9.3"
  }
}
